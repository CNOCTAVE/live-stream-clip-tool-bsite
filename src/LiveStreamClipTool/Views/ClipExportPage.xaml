<Page
    x:Class="LiveStreamClipTool.Views.ClipExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveStreamClipTool.Views"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="刷新" Click="Refresh_Click" />
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
            <TextBlock FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="导出会复制为同文件夹下的新文件名；文件名与原来不同时，复制完成后删除原切片。" />
        </StackPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="360" />
                <ColumnDefinition Width="1*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 原版切片列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="原版切片" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="ClipList"
                                  ItemsSource="{x:Bind ClipRows}"
                                  SelectionMode="Single"
                                  SelectionChanged="ClipList_SelectionChanged"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ClipExportRow">
                                    <Grid MinHeight="52" Padding="2,4" ColumnSpacing="8"
                                          ToolTipService.ToolTip="{x:Bind FilePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind MetaText}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind FileName}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" VerticalAlignment="Center"
                                                Click="DeleteRow_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyHint" Text="暂无切片" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 导出 / 语音转文字 / 自动封面 -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">

                        <StackPanel Spacing="8">
                            <TextBlock Text="导出切片" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="文件名（不含扩展名）" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FileNameBox" PlaceholderText="输入新的文件名"
                                         TextChanged="FileNameBox_TextChanged" />
                                <TextBlock x:Name="ExtText" Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="ExportButton" Grid.Column="2" Content="导出"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="Export_Click" IsEnabled="False" />
                            </Grid>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="文件名与原来不同时，导出并在复制完成后删除原切片和对应的文字文件；文件名未修改时不会执行导出。" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="语音转文字" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="TranscribeStatus" FontSize="12" TextWrapping="Wrap"
                                           Text="请选择左侧切片"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="识别任务与自动切片共用同一队列，按顺序串行执行；执行前同样会检查 CPU 占用。" />
                            </StackPanel>
                            <Button x:Name="TranscribeButton" Grid.Column="1" Content="语音转文字"
                                    VerticalAlignment="Center" IsEnabled="False"
                                    Click="Transcribe_Click" />
                        </Grid>

                        <ProgressBar x:Name="TranscribeProgress"
                                     Minimum="0" Maximum="100" Value="0"
                                     IsIndeterminate="True" Visibility="Collapsed" />

                        <TextBox x:Name="TranscriptBox" Height="70"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="选择左侧切片后会自动识别语音，也可点击「语音转文字」手动识别；结果会保存为同目录同名的 .txt 文件。" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TranscriptToggleButton" Content="展开"
                                    Click="TranscriptToggle_Click" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- 自动封面 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="自动封面" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:Name="CoverRing" Width="16" Height="16" IsActive="False" />
                                <TextBlock x:Name="CoverStatus" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Text="选择切片后自动截取 4 帧"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Frame0Box" Grid.Column="0" Tag="0" Tapped="Frame_Tapped"
                                        BorderThickness="2" CornerRadius="4" Background="#22000000"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Image x:Name="FrameImage0" Stretch="UniformToFill" Height="64" />
                                        <TextBlock Text="1" FontSize="10" Margin="4,2"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <Border x:Name="Frame1Box" Grid.Column="1" Tag="1" Tapped="Frame_Tapped"
                                        BorderThickness="2" CornerRadius="4" Background="#22000000"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Image x:Name="FrameImage1" Stretch="UniformToFill" Height="64" />
                                        <TextBlock Text="2" FontSize="10" Margin="4,2"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <Border x:Name="Frame2Box" Grid.Column="2" Tag="2" Tapped="Frame_Tapped"
                                        BorderThickness="2" CornerRadius="4" Background="#22000000"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Image x:Name="FrameImage2" Stretch="UniformToFill" Height="64" />
                                        <TextBlock Text="3" FontSize="10" Margin="4,2"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <Border x:Name="Frame3Box" Grid.Column="3" Tag="3" Tapped="Frame_Tapped"
                                        BorderThickness="2" CornerRadius="4" Background="#22000000"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Image x:Name="FrameImage3" Stretch="UniformToFill" Height="64" />
                                        <TextBlock Text="4" FontSize="10" Margin="4,2"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="封面文字（按回车换行，每行随机颜色）" />
                            <TextBox x:Name="CoverTextBox" Height="76" AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     PlaceholderText="输入封面文字，回车切分成多行" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CoverButton" Content="生成封面"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="False" Click="Cover_Click" />
                                <Button x:Name="RerollButton" Content="换一换"
                                        IsEnabled="False" Click="Reroll_Click" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="横版 16:9" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="#11000000" CornerRadius="4" Padding="2">
                                        <Image x:Name="CoverPreviewH" Stretch="Uniform" Height="122" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="竖版 3:4" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Background="#11000000" CornerRadius="4" Padding="2">
                                        <Image x:Name="CoverPreviewV" Stretch="Uniform" Height="122" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
