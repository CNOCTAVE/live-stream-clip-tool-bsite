<ContentDialog
    x:Class="LiveStreamClipTool.Dialogs.AddStreamerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加主播"
    PrimaryButtonText="添加"
    CloseButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Width="440" Spacing="12">
        <TextBlock TextWrapping="Wrap"
                   Text="输入 B 站主播 UID（个人主页网址 space.bilibili.com 后面的数字），也可以直接粘贴直播间链接。" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UidBox" PlaceholderText="例如 123456 或 https://live.bilibili.com/123456"
                     KeyDown="UidBox_KeyDown" />
            <Button x:Name="ProbeButton" Grid.Column="1" Content="检测" Click="ProbeButton_Click" />
        </Grid>
        <ProgressRing x:Name="ProbeRing" Width="22" Height="22" IsActive="False" HorizontalAlignment="Left" />
        <InfoBar x:Name="ErrorInfo" Severity="Error" IsOpen="False" IsClosable="False" />
        <Border x:Name="ResultPanel" Visibility="Collapsed" Padding="12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="RoomText" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="TitleText" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="LiveText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
