<Page
    x:Class="LiveStreamClipTool.Views.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveStreamClipTool.Views"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,18" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：主播列表 -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="主播列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox x:Name="PickSelectAll" Grid.Column="1" Content="全选"
                              IsThreeState="True" MinWidth="0"
                              Checked="PickSelectAll_Changed" Unchecked="PickSelectAll_Changed" />
                </Grid>

                <ListView Grid.Row="1" x:Name="PickList"
                          ItemsSource="{x:Bind PickRows}"
                          SelectionMode="None"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:StreamerPickRow">
                            <Grid MinHeight="40" ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Width="32" MinWidth="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Checked="PickCheck_Changed" Unchecked="PickCheck_Changed" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Nickname}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind RoomId}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="● 录制中" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Visibility="{x:Bind RecordingBadgeVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2" x:Name="PickHint" FontSize="11" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="勾选主播后点击上方「一键录制」。未勾选时「一键停止录制」会停止全部录制。" />
            </Grid>
        </Border>

        <!-- 右侧：录播操作区 -->
        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="一键录制" Style="{StaticResource AccentButtonStyle}"
                        Click="StartAll_Click" />
                <Button Content="一键停止录制" Click="StopAll_Click" />
                <Button Content="设置自动停止录播" Click="AutoStop_Click" />
                <Button Content="一键删除录播文件" Click="DeleteFiles_Click" />
                <Button Content="添加本地视频" Click="AddLocal_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                <TextBlock x:Name="AutoStopText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

            <!-- 表头 -->
            <Grid Grid.Row="2" Padding="4,0" BorderThickness="0,0,0,1"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="1.0*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.65*" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="RecordSelectAll" Grid.Column="0" Width="32" MinWidth="0"
                          VerticalAlignment="Center" IsThreeState="True"
                          Checked="RecordSelectAll_Changed" Unchecked="RecordSelectAll_Changed"
                          ToolTipService.ToolTip="全选录播记录" />
                <TextBlock Grid.Column="1" Text="主播" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="2" Text="直播间标题" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="3" Text="录制状态" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="4" Text="停止原因" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="5" Text="文件" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="6" Text="开始时间" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="7" Text="时长" Style="{StaticResource HeaderText}" />
                <TextBlock Grid.Column="8" Text="操作" Style="{StaticResource HeaderText}" />
            </Grid>

            <!-- 录制状态列表 -->
            <ListView x:Name="RecordList" Grid.Row="3"
                      ItemsSource="{x:Bind RecordRows}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="40" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:RecordingRow">
                        <Grid MinHeight="40" Padding="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.65*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Width="32" MinWidth="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      Checked="RowCheck_Changed" Unchecked="RowCheck_Changed" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CellText}"
                                       Text="{x:Bind StreamerName}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CellText}"
                                       Text="{x:Bind RoomTitle}" ToolTipService.ToolTip="{x:Bind RoomTitle}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CellText}"
                                       Text="{x:Bind StatusText, Mode=OneWay}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource CellText}"
                                       Text="{x:Bind StopReason, Mode=OneWay}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource CellText}"
                                       Text="{x:Bind FileName}" ToolTipService.ToolTip="{x:Bind FilePath}" />
                            <TextBlock Grid.Column="6" Style="{StaticResource CellText}"
                                       Text="{x:Bind StartedText}" />
                            <TextBlock Grid.Column="7" Style="{StaticResource CellText}"
                                       Text="{x:Bind DurationText, Mode=OneWay}" />
                            <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Content="停止" FontSize="12" MinWidth="0"
                                        Padding="8,3"
                                        Visibility="{x:Bind StopButtonVisibility, Mode=OneWay}"
                                        Click="StopRow_Click" />
                                <Button Content="删除" FontSize="12" MinWidth="0"
                                        Padding="8,3"
                                        Click="DeleteRow_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
