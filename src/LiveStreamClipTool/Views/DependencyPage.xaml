<Page
    x:Class="LiveStreamClipTool.Views.DependencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveStreamClipTool.Views"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="重新检测" Click="Detect_Click" />
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
            <TextBlock x:Name="SummaryText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="4,0,4,6" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="状态" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="1" Text="依赖名称" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="2" Text="详细信息" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource HeaderText}" />
                </Grid>

                <ListView x:Name="DependencyList" Grid.Row="1"
                          ItemsSource="{x:Bind Rows}"
                          SelectionMode="None"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="64" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DependencyRow">
                            <Grid MinHeight="64" Padding="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="●" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Visibility="{x:Bind InstalledVisibility, Mode=OneWay}" />
                                    <TextBlock Text="●" FontSize="16" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{x:Bind NotInstalledVisibility, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                           FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="2" Text="{x:Bind DetailText, Mode=OneWay}"
                                           FontSize="12" VerticalAlignment="Center" Margin="4,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           ToolTipService.ToolTip="{x:Bind DetailText, Mode=OneWay}" />

                                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button Content="{x:Bind InstallButtonText}" FontSize="12"
                                            MinWidth="0" Padding="12,4"
                                            Visibility="{x:Bind InstallButtonVisibility, Mode=OneWay}"
                                            Click="InstallRow_Click" />
                                    <ProgressRing Width="22" Height="22"
                                                  IsActive="{x:Bind IsInstalling, Mode=OneWay}"
                                                  Visibility="{x:Bind InstallingVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" FontSize="11" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="FFmpeg / Python / Chocolatey 通过 Chocolatey 安装，需要管理员授权（会弹出 UAC）。如果电脑上没有 Chocolatey，会先自动静默安装 Chocolatey，再继续安装所选依赖。Whisper 语音识别通过 pip 安装到当前用户，无需管理员权限。安装完成后可能需要在设置中指定可执行文件路径。" />
    </Grid>
</Page>
