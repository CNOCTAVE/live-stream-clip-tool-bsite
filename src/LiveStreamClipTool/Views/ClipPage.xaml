<Page
    x:Class="LiveStreamClipTool.Views.ClipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LiveStreamClipTool.Views"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,18,24,18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="刷新" Click="Refresh_Click" />
            <Button Content="一键删除" Click="DeleteSelected_Click" />
            <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar x:Name="PageInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <!-- 自动切片进度 -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" Spacing="4" Visibility="Collapsed">
            <ProgressBar x:Name="ClipProgress" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="3" Padding="4,0" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="2.8*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="SelectAllBox" MinWidth="0" Width="32"
                      VerticalAlignment="Center" IsThreeState="True"
                      ToolTipService.ToolTip="全选 / 取消全选"
                      Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
            <TextBlock Grid.Column="1" Text="主播" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="2" Text="切片时间" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="3" Text="时长" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="4" Text="切片存储路径" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource HeaderText}" />
        </Grid>

        <ListView x:Name="ClipList" Grid.Row="4"
                  ItemsSource="{x:Bind ClipRows}"
                  SelectionMode="None"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ClipRow">
                    <Grid MinHeight="40" Padding="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="2.8*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" MinWidth="0" Width="32"
                                  VerticalAlignment="Center"
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  Checked="RowCheck_Changed" Unchecked="RowCheck_Changed" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CellText}"
                                   Text="{x:Bind StreamerName}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CellText}"
                                   Text="{x:Bind ClipTimeText}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CellText}"
                                   Text="{x:Bind DurationText}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CellText}"
                                   Text="{x:Bind FilePath}" ToolTipService.ToolTip="{x:Bind FilePath}" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Content="打开文件夹" FontSize="12" MinWidth="0"
                                    Padding="8,3" Click="OpenClipFolder_Click" />
                            <Button Content="删除" FontSize="12" MinWidth="0"
                                    Padding="8,3" Click="DeleteRow_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
