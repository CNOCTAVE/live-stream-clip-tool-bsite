<ContentDialog
    x:Class="LiveStreamClipTool.Dialogs.AutoStopDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置自动停止录播"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Width="400" Spacing="12">
        <TextBlock
            TextWrapping="Wrap"
            Text="任意一路录制达到设定的时长后自动停止，并在停止后自动执行切片，避免切片视频过长导致处理过慢或硬盘占满。" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <NumberBox
                x:Name="MinutesBox"
                Width="180"
                Minimum="0"
                Maximum="1440"
                SpinButtonPlacementMode="Compact" />
            <TextBlock Text="分钟（0 表示关闭）" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
