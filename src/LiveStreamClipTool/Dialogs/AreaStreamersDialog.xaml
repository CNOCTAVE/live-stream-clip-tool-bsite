<ContentDialog
    x:Class="LiveStreamClipTool.Dialogs.AreaStreamersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="一键添加分区推荐主播"
    CloseButtonText="取消"
    DefaultButton="Close">

    <Grid Width="500" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="AreasRing" Width="20" Height="20" IsActive="False" />
            <TextBlock x:Name="AreaStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="正在从 B 站直播主页获取分区…" />
            <Button x:Name="RetryButton" Content="重试" Visibility="Collapsed"
                    Click="RetryButton_Click" />
        </StackPanel>

        <InfoBar x:Name="AreaError" Grid.Row="1" Severity="Error" IsOpen="False"
                 IsClosable="False" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="一级分区" FontWeight="SemiBold" FontSize="13" />
                <ScrollViewer Height="270" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ParentPanel" Spacing="4" />
                </ScrollViewer>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock x:Name="SubTitle" Text="二级分区" FontWeight="SemiBold" FontSize="13" />
                <ScrollViewer Height="270" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="SubPanel" RowSpacing="4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="最大添加人数" VerticalAlignment="Center" FontSize="13" />
            <NumberBox x:Name="MaxCountBox" Width="110" Minimum="0" SmallChange="1"
                       SpinButtonPlacementMode="Compact" Value="10" />
            <TextBlock Text="只取接口返回的前 N 位主播，0 表示不限制" VerticalAlignment="Center"
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="SelectSummary" Grid.Row="4" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="请选择一级分区，再选择二级分区；两级都选好后弹窗会自动关闭并按上方人数限制添加该分区的主播。" />
    </Grid>
</ContentDialog>
